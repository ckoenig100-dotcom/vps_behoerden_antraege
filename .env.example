# URL des n8n-Webhooks, der den Antrag als PDF erstellt und per E-Mail versendet.
PUBLIC_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/antrag
# URL des n8n-Webhooks, der eine Stripe-Checkout-Session erstellt (Bezahlschranke).
PUBLIC_CHECKOUT_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/checkout
# URL des n8n-Webhooks für den Admin-Bereich (welche Formulare kostenpflichtig sind).
PUBLIC_ADMIN_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/admin-config
# URL des n8n-Webhooks, der einen E-Mail-Bestätigungstoken abschließt.
PUBLIC_VERIFY_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/verify-email
