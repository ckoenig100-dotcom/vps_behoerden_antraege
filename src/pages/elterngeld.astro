---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Formularhilfe — Elterngeld beantragen"
	description="Beantragen Sie Elterngeld in wenigen einfachen Schritten. Wir erstellen Ihren Antrag als PDF."
>
	<section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
		<h1 class="text-3xl font-bold text-brand-blue sm:text-4xl">Elterngeld beantragen</h1>
		<p class="mt-4 text-lg text-slate-600">
			Der geführte Fragebogen für den Elterngeldantrag folgt in Kürze.
		</p>
	</section>
</Layout>
