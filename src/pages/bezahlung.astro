---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Formularhilfe — Zahlung erforderlich"
	description="Ihr kostenloses Kontingent ist ausgeschöpft. Wählen Sie eine Zahlungsoption, um Ihren Antrag zu erstellen."
>
	<section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
		<h1 class="text-3xl font-bold text-brand-blue sm:text-4xl">Zahlung erforderlich</h1>
		<p class="mt-4 text-lg text-slate-600">
			Sie haben Ihr kostenloses Kontingent von 3 Anträgen ausgeschöpft. Bitte wählen Sie eine
			Option, um diesen Antrag zu erstellen und per E-Mail zu erhalten.
		</p>

		<div id="loading" class="mt-8 text-slate-500">Lade Zahlungsoptionen…</div>

		<div id="options" class="mt-8 hidden grid gap-4 sm:grid-cols-2">
			<button
				type="button"
				id="btn-einmalig"
				class="flex min-h-11 flex-col items-center gap-2 rounded-2xl border-2 border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-brand-blue hover:shadow-md disabled:cursor-not-allowed disabled:opacity-50"
			>
				<span class="text-2xl font-bold text-brand-blue">4,99 €</span>
				<span class="font-semibold text-slate-900">Einzelantrag</span>
				<span class="text-sm text-slate-600">Einmalige Zahlung für diesen einen Antrag</span>
			</button>

			<button
				type="button"
				id="btn-abo"
				class="flex min-h-11 flex-col items-center gap-2 rounded-2xl border-2 border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-brand-green hover:shadow-md disabled:cursor-not-allowed disabled:opacity-50"
			>
				<span class="text-2xl font-bold text-brand-green">9,99 € / Monat</span>
				<span class="font-semibold text-slate-900">Monatsabo</span>
				<span class="text-sm text-slate-600">Unbegrenzt viele Anträge, monatlich kündbar</span>
			</button>
		</div>

		<p id="page-error" class="mt-6 hidden rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"></p>
	</section>
</Layout>

<script>
	// @ts-nocheck
	const params = new URLSearchParams(window.location.search);
	const pendingId = params.get("pendingId");
	const antragstyp = params.get("antragstyp");

	const loading = document.getElementById("loading");
	const options = document.getElementById("options");
	const pageError = document.getElementById("page-error");
	const btnEinmalig = document.getElementById("btn-einmalig");
	const btnAbo = document.getElementById("btn-abo");

	function showError(message) {
		pageError.textContent = message;
		pageError.classList.remove("hidden");
	}

	if (!pendingId) {
		loading.classList.add("hidden");
		showError(
			"Es fehlt eine gültige Antrags-Referenz. Bitte starten Sie den Antrag erneut über das Formular."
		);
	} else {
		loading.classList.add("hidden");
		options.classList.remove("hidden");
	}

	async function starteCheckout(plan) {
		btnEinmalig.disabled = true;
		btnAbo.disabled = true;
		pageError.classList.add("hidden");

		try {
			const webhookUrl = import.meta.env.PUBLIC_CHECKOUT_WEBHOOK_URL;
			const response = await fetch(webhookUrl, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ pendingId, plan }),
			});
			const result = await response.json().catch(() => null);

			if (!response.ok || !result?.success || !result?.checkoutUrl) {
				throw new Error(result?.message ?? "Checkout konnte nicht gestartet werden.");
			}

			window.location.href = result.checkoutUrl;
		} catch (error) {
			showError(
				error instanceof Error && error.message
					? error.message
					: "Beim Starten der Zahlung ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut."
			);
			btnEinmalig.disabled = false;
			btnAbo.disabled = false;
		}
	}

	btnEinmalig?.addEventListener("click", () => starteCheckout("einmalig"));
	btnAbo?.addEventListener("click", () => starteCheckout("abo"));
</script>
